# Environment variables template (safe to commit)
# Copy this file to .env locally and fill in real values (never commit .env)

# Suunto Cloud API
SUUNTO_CLIENT_ID=your_suunto_client_id
SUUNTO_CLIENT_SECRET=your_suunto_client_secret
SUUNTO_SUBSCRIPTION_KEY=your_suunto_subscription_key
SUUNTO_WEBHOOK_SECRET=your_suunto_webhook_secret

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id

# App Authentication (personal single-user JWT)
APP_USER_EMAIL=diver@example.com
APP_JWT_SECRET=replace_with_a_long_random_secret

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
